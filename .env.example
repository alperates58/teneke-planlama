# Teneke Planlama Ortam Değişkenleri
PORT=3000
NODE_ENV=production
APP_NAME=Teneke Planlama
APP_ENV=local_demo
TZ=Europe/Istanbul

# PostgreSQL (Faz 2 Kalıcı Veri)
POSTGRES_DB=teneke_planlama
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/teneke_planlama

# Gelecek Faz 3 ERP Entegrasyonu (Salt Okunur)
ERP_SQL_HOST=sql01.fabrika.local
ERP_SQL_PORT=1433
ERP_SQL_DB=LIDER_ERP
ERP_SQL_USER=erp_readonly_user
ERP_SQL_PASSWORD=
